NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSCODE=
NEXT_PUBLIC_MAIN_SITE_URL=https://travel-zeta-lac.vercel.app
NEXT_PUBLIC_SURVEY_URL=https://docs.google.com/forms/d/1uuheFOZgCXhNJBBLb62gnB3x0V10J6gxwmO3HiMLYc8/viewform

# ผู้ช่วย AI (Google AI Studio) — ไม่ตั้ง = ปิดฟีเจอร์แชต
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# ช่วงข้อมูลวิจัย (วันตัดข้อมูลของรายงาน, YYYY-MM-DD) — ไม่ตั้ง = ซ่อนปุ่ม "ช่วงข้อมูลวิจัย"
NEXT_PUBLIC_RESEARCH_FROM=
NEXT_PUBLIC_RESEARCH_TO=

# ชื่อผู้จัดทำ/อาจารย์ที่ปรึกษาที่แสดงในหน้า /about (ไม่ตั้ง = ไม่แสดง)
NEXT_PUBLIC_RESEARCH_CREDIT=

# dev เท่านั้น: CHAT_MOCK=1 = เปิดแชตแบบคำตอบจำลองโดยไม่ใช้คีย์ (ห้ามใช้บน production)
